{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist/skyline-residencial/browser",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "dist/skyline-residencial/**"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
